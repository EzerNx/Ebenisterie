<?xml version="1.0" encoding="utf-8"?>
<!--
  Publication de Collabox Import en un seul fichier .exe autonome :
  le .NET n'a pas besoin d'être installé sur les autres PC.
  Visual Studio : clic droit sur le projet > Publier > CollaboxImport > Publier
  Ligne de commande : dotnet publish -p:PublishProfile=CollaboxImport
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Publish\CollaboxImport\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bibliothèques natives de SqlClient intégrées dans le .exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
