<?xml version="1.0" encoding="utf-8"?>
<!--
  Sources NuGet de ce projet uniquement.
  Remplace le Package Source Mapping de la configuration NuGet du PC, qui bloquait
  le téléchargement du runtime .NET win-x64 nécessaire à la publication autonome.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
